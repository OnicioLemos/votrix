{
  "name": "votrix-api",
  "version": "1.0.0",
  "description": "Votrix - sistema de votação da feira técnica (API Express + Prisma + MySQL)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:push": "prisma db push",
    "seed": "node prisma/seed.js",
    "seed:demo": "node prisma/seed-demo.js",
    "setup": "prisma db push && node prisma/seed.js",
    "reset": "prisma db push --force-reset && node prisma/seed.js",
    "studio": "prisma studio"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.5.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  }
}
